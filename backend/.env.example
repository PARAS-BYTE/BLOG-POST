# UTSANOVA Blog System - Backend Environment Configuration

# Server Port (default 5000)
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=production

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/utsanova_blog?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/utsanova_blog?retryWrites=true&w=majority

# JWT Authentication Secret Key (Used to cryptographically sign Admin session tokens)
JWT_SECRET=your_super_strong_jwt_secret_key_here

# Groq Cloud API Key (For AI-powered article drafting with LLM)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Vercel Cron Secret (Guards /api/cron/publish-scheduled-posts against unauthorized public calls)
# Set the exact same value in your Vercel Project Settings -> Environment Variables
CRON_SECRET=your_random_generated_cron_secret_token_here
